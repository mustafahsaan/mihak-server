APP_NAME="مِحَكّ"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL أو MariaDB (مثلاً من XAMPP). أنشئ قاعدة باسم mihak أولاً
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mihak
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=240
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ---------- المنصة ----------
# true = بوابة دفع تجريبية بدل زين كاش وكي كارد (للتشغيل المحلي فقط)
MIHAK_FAKE_PAYMENTS=true
# مجموعة Google التي يضيفها المطوّر إلى قائمة الاختبار المغلق
MIHAK_GROUP_EMAIL=mihak-testers@googlegroups.com
# رابط تحميل تطبيق المختبِرين (APK أو Google Play)
MIHAK_TESTER_APP_URL=
# صرف السحوبات تلقائياً إلى محافظ زين كاش عبر Cash Disbursement API
MIHAK_AUTO_ZAINCASH_PAYOUTS=false

# حساب الإدارة الأول (يُنشأ عند php artisan db:seed)
ADMIN_NAME="مدير المنصة"
ADMIN_PHONE=07700000000
ADMIN_PASSWORD=change-me-now

# ---------- الرسائل النصية (OTP) ----------
# log = يكتب الرمز في storage/logs/laravel.log بدل الإرسال
SMS_DRIVER=log

# ---------- زين كاش (Payment Gateway v2) ----------
ZAINCASH_BASE_URL=https://pg-api-uat.zaincash.iq
ZAINCASH_CLIENT_ID=
ZAINCASH_CLIENT_SECRET=
# مفتاح التحقق من توقيع token الراجع من زين كاش (HS256)
ZAINCASH_API_KEY=
ZAINCASH_SERVICE_TYPE="Testing service"
ZAINCASH_LANGUAGE=ar

# ---------- كي كارد (Qi Payment Gateway) ----------
QICARD_BASE_URL=https://uat-sandbox-3ds-api.qi.iq/api/v1
QICARD_TERMINAL_ID=
QICARD_USERNAME=
QICARD_PASSWORD=
QICARD_LOCALE=en_US
# المفتاح العام للتحقق من إشعارات كي كارد (يُطلب من دعم البوابة)
QICARD_PUBLIC_KEY_PATH=storage/app/private/qicard-public.pem
